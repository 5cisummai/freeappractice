{
  "name": "freeappractice-svelte",
  "private": true,
  "version": "1.10.3",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun run test:unit",
    "test:unit": "vitest run",
    "smoke:question": "bun scripts/smoke-question.ts",
    "quality": "bun scripts/question-quality.ts",
    "quality:eval": "bun scripts/evaluate-question-quality-agent.ts",
    "questions:preview": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/preview-question-batch.ts",
    "pool:fill": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/fill-question-pool.ts",
    "pool:reconcile": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/reconcile-question-pool.ts",
    "pool:batch-submit": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/batch-submit-question-pool.ts",
    "pool:batch-collect": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/batch-collect-question-pool.ts",
    "pool:retire": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/retire-question-pool.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:apply": "bun scripts/apply-neon-migrations.ts",
    "db:backfill-question-jsonb": "bun scripts/backfill-question-jsonb.ts",
    "db:backfill-apclass-to-course": "bun scripts/backfill-apclass-to-course.ts",
    "db:backfill-retire-bad-quality": "bun scripts/backfill-retire-bad-quality-questions.ts",
    "db:sync-ap-art-history": "bun scripts/ap-art-history/sync-works.ts",
    "auth:cleanup-unverified": "bun scripts/cleanup-unverified-users.ts",
    "auth:trim-user-names": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/trim-user-names.ts",
    "auth:backfill-personal-orgs": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/backfill-personal-organizations.ts",
    "classroom:access": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/manage-classroom-access.ts",
    "classroom:audit": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/audit-practice-context.ts",
    "classroom:backfill": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/backfill-practice-context.ts",
    "classroom:sharing": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/initialize-group-sharing.ts",
    "classroom:verify": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/verify-practice-context.ts",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && bun run lint:oxlint && bun run lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --concurrency auto --cache --cache-location .eslintcache",
    "format": "prettier --write .",
    "storage:local": "bun scripts/local-coach-storage.ts"
  },
  "devDependencies": {
    "@eslint/compat": "latest",
    "@eslint/js": "latest",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.66.0",
    "@sveltejs/adapter-vercel": "^7.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/mcp": "0.1.26",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.13.3",
    "@vercel/toolbar": "^0.2.7",
    "bits-ui": "^2.20.3",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.90.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "layerchart": "^2.9.2",
    "oxlint": "^1.90.0",
    "paneforge": "^1.0.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "shadcn-svelte": "^1.7.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@ai-sdk/svelte": "^5.0.159",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/stripe": "1.6.30",
    "@devmischief/shaders-svelte": "^0.0.9",
    "@examfig/charts": "^0.2.0",
    "@examfig/core": "^0.2.0",
    "@examfig/science": "^0.2.0",
    "@flags-sdk/vercel": "^1.6.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/open-runde": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/sveltekit": "^11.10.0",
    "@tabler/icons-svelte": "^3.50.0",
    "@tanstack/table-core": "^8.21.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "@vercel/analytics": "2.3.0-canary",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.5",
    "@vercel/speed-insights": "2.1.0-canary",
    "ai": "^7.0.159",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.7",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "flags": "^4.4.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "marked": "^17.0.6",
    "marked-highlight": "^2.2.4",
    "mem0ai": "3.1.8",
    "mode-watcher": "^1.1.0",
    "motion-sv": "^0.1.13",
    "opentype.js": "^2.0.0",
    "parallel-web": "^1.3.7",
    "posthog-js": "^1.444.0",
    "posthog-node": "^5.61.1",
    "resend": "^6.37.0",
    "runed": "^0.37.1",
    "sharp": "^0.35.5",
    "stripe": "22.6.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "motion-dom": "12.40.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}