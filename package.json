		"@upstash/vector": "^1.2.3",
		"@vercel/analytics": "2.0.1",
		"@vercel/functions": "^3.9.3",
		"@vercel/speed-insights": "^2.0.0",
		"ai": "^6.0.209",
		"bcryptjs": "^3.0.3",
		"better-auth": "1.6.26",
		"dompurify": "^3.4.13",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"flags": "^4.3.0",
		"highlight.js": "^11.12.0",
		"katex": "^0.16.47",
		"marked": "^17.0.6",
		"marked-highlight": "^2.2.4",
		"mem0ai": "3.1.4",
		"mode-watcher": "^1.1.0",
		"motion-sv": "^0.1.13",
		"opentype.js": "^2.0.0",
		"pdf-lib": "^1.17.1",
		"posthog-js": "^1.415.6",
		"posthog-node": "^5.48.1",
		"resend": "^6.19.0",
		"runed": "^0.37.1",
		"streamdown-svelte": "^3.0.6",
		"stripe": "22.4.0",
		"zod": "^4.4.3"
	},
	"overrides": {
		"motion-dom": "12.40.0"
	},
	"patchedDependencies": {
		"bits-ui@2.18.1": "patches/bits-ui@2.18.1.patch",
		"@sveltejs/kit@2.70.2": "patches/@sveltejs%2Fkit@2.70.2.patch"
