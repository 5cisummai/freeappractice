{
	"name": "freeappractice-svelte",
	"private": true,
	"version": "1.5.3",
	"packageManager": "bun@1.3.14",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun run db:apply && vite build",
		"preview": "vite preview",
		"test": "playwright test",
		"test:unit": "vitest run",
		"quality": "bun scripts/question-quality.ts",
		"quality:eval": "bun scripts/evaluate-question-quality-agent.ts",
		"sync:question-ids": "bun scripts/sync-question-ids-from-s3.ts",
		"pool:backfill-s3": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/backfill-question-pool-from-s3.ts",
		"pool:fill": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/fill-question-pool.ts",
		"pool:reconcile": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/reconcile-question-pool.ts",
		"pool:batch-submit": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/batch-submit-question-pool.ts",
		"pool:batch-collect": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/batch-collect-question-pool.ts",
		"pool:retire": "bun scripts/retire-question-pool.ts",
		"db:migrate": "bun scripts/migrate-mongo-to-neon.ts",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:apply": "bun scripts/apply-neon-migrations.ts",
		"db:migrate:inventory": "bun scripts/migrate-mongo-to-neon.ts --phase=inventory",
		"db:migrate:load": "bun scripts/migrate-mongo-to-neon.ts --phase=load",
		"db:migrate:verify": "bun scripts/migrate-mongo-to-neon.ts --phase=verify",
		"auth:cleanup-unverified": "bun scripts/cleanup-unverified-users.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "latest",
		"@eslint/js": "latest",
		"@fontsource-variable/fraunces": "^5.2.9",
		"@fontsource-variable/geist": "^5.2.9",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.21.0",
		"@playwright/test": "^1.61.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.67.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.1",
		"@types/node": "^24.13.2",
		"@vercel/toolbar": "^0.2.6",
		"drizzle-kit": "^0.31.4",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.7.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"shadcn-svelte": "^1.4.1",
		"svelte": "^5.56.3",
		"svelte-check": "^4.7.0",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.1",
		"tsx": "^4.22.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.62.0",
		"vite": "^8.1.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@ai-sdk/openai": "^3.0.74",
		"@ai-sdk/svelte": "4.0.209",
		"@aws-sdk/client-s3": "^3.1075.0",
		"@better-auth/drizzle-adapter": "1.6.26",
		"@better-auth/stripe": "1.6.26",
		"@flags-sdk/vercel": "^1.4.5",
		"@neondatabase/serverless": "^1.0.2",
		"@sentry/sveltekit": "^10",
		"@shikijs/langs": "^4.0.2",
		"@shikijs/themes": "^4.0.2",
		"@tabler/icons-svelte": "^3.46.0",
		"@tanstack/table-core": "^8.21.3",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.38.2",
		"@upstash/vector": "^1.2.3",
		"@vercel/analytics": "2.0.1",
		"@vercel/functions": "^3.7.3",
		"@vercel/speed-insights": "^2.0.0",
		"ai": "^6.0.209",
		"bcryptjs": "^3.0.3",
		"better-auth": "1.6.26",
		"dompurify": "^3.3.1",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"flags": "^4.2.0",
		"highlight.js": "^11.11.1",
		"katex": "^0.16.47",
		"marked": "^17.0.6",
		"marked-highlight": "^2.2.4",
		"mem0ai": "3.1.4",
		"mode-watcher": "^1.1.0",
		"mongodb": "^7.3.0",
		"motion-sv": "^0.1.13",
		"opentype.js": "^2.0.0",
		"pdf-lib": "^1.17.1",
		"posthog-js": "^1.393.5",
		"posthog-node": "^5.38.5",
		"resend": "^6.14.0",
		"runed": "^0.37.1",
		"shiki": "^4.0.2",
		"streamdown-svelte": "^3.0.6",
		"stripe": "22.4.0",
		"svelte-toolbelt": "^0.10.5",
		"zod": "^4.4.3"
	},
	"overrides": {
		"motion-dom": "12.40.0"
	},
	"patchedDependencies": {
		"bits-ui@2.18.1": "patches/bits-ui@2.18.1.patch"
	}
}
