	"dependencies": {
		"@ai-sdk/openai": "^3.0.74",
		"@ai-sdk/svelte": "4.0.209",
		"@aws-sdk/client-s3": "^3.1108.0",
		"@better-auth/drizzle-adapter": "1.6.26",
		"@better-auth/stripe": "1.6.26",
		"@devmischief/shaders-svelte": "^0.0.9",
		"@examfig/charts": "^0.2.0",
		"@examfig/core": "^0.2.0",
		"@examfig/science": "^0.2.0",
		"@flags-sdk/vercel": "^1.4.6",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource/noto-serif": "^5.3.0",
		"@fontsource/open-runde": "^5.3.0",
		"@neondatabase/serverless": "^1.1.0",
