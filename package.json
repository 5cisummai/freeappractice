{
	"name": "freeappractice-svelte",
	"private": true,
	"version": "1.7.4",
	"packageManager": "bun@1.3.14",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "bun run test:unit",
		"test:unit": "vitest run",
		"quality": "bun scripts/question-quality.ts",
		"quality:eval": "bun scripts/evaluate-question-quality-agent.ts",
		"questions:preview": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/preview-question-batch.ts",
		"sync:question-ids": "bun scripts/sync-question-ids-from-s3.ts",
		"pool:backfill-s3": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/backfill-question-pool-from-s3.ts",
		"pool:fill": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/fill-question-pool.ts",
		"pool:reconcile": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/reconcile-question-pool.ts",
		"pool:batch-submit": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/batch-submit-question-pool.ts",
		"pool:batch-collect": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/batch-collect-question-pool.ts",
		"pool:retire": "bun scripts/retire-question-pool.ts",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:apply": "bun scripts/apply-neon-migrations.ts",
		"db:backfill-question-jsonb": "bun scripts/backfill-question-jsonb.ts",
		"auth:cleanup-unverified": "bun scripts/cleanup-unverified-users.ts",
		"auth:trim-user-names": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/trim-user-names.ts",
		"auth:backfill-personal-orgs": "bun --preload ./scripts/bun-sveltekit-env-preload.ts scripts/backfill-personal-organizations.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "latest",
		"@eslint/js": "latest",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.32.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.3",
