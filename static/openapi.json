	"components": {
		"securitySchemes": {
			"sessionCookie": {
				"type": "apiKey",
				"in": "cookie",
				"name": "better-auth.session_token",
				"description": "Better Auth session cookie issued after sign-in. HTTPS uses the __Secure- prefix."
			}
		},
		"parameters": {
			"questionId": {
				"name": "questionId",
				"in": "path",
				"required": true,
				"schema": { "type": "string" }
			},
			"memoryId": {
				"name": "memoryId",
				"in": "path",
				"required": true,
				"schema": { "type": "string" }
			},
			"conversationId": {
				"name": "id",
				"in": "path",
				"required": true,
				"schema": { "type": "string" }
			},
			"sharedSetId": {
				"name": "id",
				"in": "path",
				"required": true,
				"schema": { "type": "string" }
			}
		},
		"schemas": {
			"QuestionRequest": {
				"type": "object",
				"required": ["course"],
				"properties": {
					"course": {
						"type": "string",
						"example": "AP Biology",
						"description": "Supported AP course name"
					},
					"unit": {
						"type": "string",
						"example": "Unit 1: Chemistry of Life"
					},
					"formatId": {
						"type": "string",
						"description": "Optional FRQ format identifier"
					},
					"excludeQuestionIds": {
						"type": "array",
						"items": { "type": "string" },
						"maxItems": 100
					}
				}
			}
		}
	}
}
