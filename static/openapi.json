{
	"openapi": "3.1.0",
	"info": {
		"title": "Free AP Practice API",
		"version": "1.9.4",
		"description": "Public and authenticated APIs for AP practice (MCQ and FRQ), quizzes, progress tracking, the AI tutor, Coach, Super, and shared practice sets. Admin, cron, and webhook routes are not documented here.",
		"contact": {
			"name": "Free AP Practice Support",
			"email": "support@freeappractice.org",
			"url": "https://freeappractice.org/about"
		}
	},
	"servers": [
		{
			"url": "https://freeappractice.org"
		}
	],
	"tags": [
		{ "name": "health", "description": "Service health" },
		{ "name": "questions", "description": "MCQ question serving and quizzes" },
		{ "name": "frq", "description": "Written-response (FRQ) practice and grading" },
		{ "name": "user", "description": "Authenticated user data" },
		{ "name": "tutor", "description": "AI tutor chat" },
		{ "name": "coach", "description": "Super Coach agent" },
		{ "name": "super", "description": "Super plan, profile, conversations, and memory" },
		{ "name": "practice", "description": "Shared practice sets" },
		{ "name": "orgs", "description": "Organizations and invite links" },
		{ "name": "feedback", "description": "App and question feedback" },
		{ "name": "auth", "description": "Better Auth session endpoints" }
	],
	"paths": {
		"/health": {
			"get": {
				"tags": ["health"],
				"summary": "Health check",
				"responses": {
					"200": {
						"description": "Service is healthy",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"status": { "type": "string", "example": "ok" },
										"timestamp": { "type": "string", "format": "date-time" }
									}
								}
							}
						}
					}
				}
			}
		},
		"/api/question": {
			"post": {
				"tags": ["questions"],
				"summary": "Serve one MCQ from the question pool",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/QuestionRequest" }
						}
					}
				},
				"responses": {
					"200": { "description": "Question payload with questionId and answer metadata" },
					"400": { "description": "Invalid request" },
					"410": { "description": "Deprecated customTopic request" },
					"413": { "description": "Request body too large" },
					"429": { "description": "Rate limited" },
					"500": { "description": "Request failed" },
					"503": { "description": "Question pool warming or unavailable" }
				}
			}
		},
		"/api/questions/batch": {
			"post": {
				"tags": ["questions"],
				"summary": "Serve a batch of MCQs from the question pool",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"allOf": [
									{ "$ref": "#/components/schemas/QuestionRequest" },
									{
										"type": "object",
										"required": ["count"],
										"properties": {
											"count": {
												"type": "integer",
												"minimum": 1,
												"maximum": 10,
												"description": "Number of questions to return"
											}
										}
									}
								]
							}
						}
					}
				},
				"responses": {
					"200": { "description": "Batch of question payloads" },
					"400": { "description": "Invalid request" },
					"410": { "description": "Deprecated customTopic request" },
					"413": { "description": "Request body too large" },
					"429": { "description": "Rate limited" },
					"500": { "description": "Request failed" },
					"503": { "description": "Question pool warming or unavailable" }
				}
			}
		},
		"/api/question/quiz": {
			"post": {
				"tags": ["questions"],
				"summary": "Assemble an MCQ quiz",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"allOf": [
									{ "$ref": "#/components/schemas/QuestionRequest" },
									{
										"type": "object",
										"properties": {
											"count": {
												"type": "integer",
												"minimum": 1,
												"maximum": 50,
												"default": 10
											},
											"unitRange": {
												"type": "array",
												"minItems": 2,
												"maxItems": 2,
												"items": { "type": "integer", "minimum": 0 },
												"description": "Inclusive unit index range"
											}
										}
									}
								]
							}
						}
					}
				},
				"responses": {
					"200": { "description": "Assembled quiz questions" },
					"400": { "description": "Invalid request" },
					"413": { "description": "Request body too large" },
					"429": { "description": "Rate limited" },
					"500": { "description": "Quiz assembly failed" },
					"503": { "description": "Question pool warming" }
				}
			}
		},
		"/api/question/by-id/{questionId}": {
			"get": {
				"tags": ["questions"],
				"summary": "Get a cached MCQ by id",
				"parameters": [{ "$ref": "#/components/parameters/questionId" }],
				"responses": {
					"200": { "description": "Question payload" },
					"400": { "description": "questionId is required" },
					"404": { "description": "Question not found" }
				}
			}
		},
		"/api/question/generation-stats": {
			"get": {
				"tags": ["questions"],
				"summary": "Public MCQ generation and registry stats",
				"responses": {
					"200": { "description": "Generation stats" },
					"500": { "description": "Failed to load stats" }
				}
			}
		},
		"/api/question/feedback": {
			"post": {
				"tags": ["feedback"],
				"summary": "Submit feedback on a question",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"202": { "description": "Feedback accepted" },
					"400": { "description": "Invalid feedback request" },
					"401": { "description": "Not authenticated" }
				}
			}
		},
		"/api/question/frq": {
			"post": {
				"tags": ["frq"],
				"summary": "Serve one FRQ from the written-response pool",
				"security": [{ "sessionCookie": [] }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/QuestionRequest" }
						}
					}
				},
				"responses": {
					"200": { "description": "FRQ payload" },
					"400": { "description": "Invalid request or course/format not supported" },
					"401": { "description": "Not authenticated" },
					"403": { "description": "FRQ practice is disabled" },
					"503": { "description": "Question pool warming or unavailable" }
				}
			}
		},
		"/api/question/frq/by-id/{questionId}": {
			"get": {
				"tags": ["frq"],
				"summary": "Get a cached FRQ by id",
				"parameters": [{ "$ref": "#/components/parameters/questionId" }],
				"responses": {
					"200": { "description": "FRQ payload" },
					"400": { "description": "questionId is required" },
					"403": { "description": "FRQ practice is disabled" },
					"404": { "description": "Question not found" }
				}
			}
		},
		"/api/question/frq/grade": {
			"post": {
				"tags": ["frq"],
				"summary": "Grade a written response",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"200": { "description": "Graded attempt" },
					"400": { "description": "Invalid written response" },
					"401": { "description": "Not authenticated" },
					"403": { "description": "FRQ practice is disabled" },
					"409": { "description": "Attempt already in progress" }
				}
			}
		},
		"/api/me/stats": {
			"get": {
				"tags": ["user"],
				"summary": "Get user practice statistics",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"200": { "description": "User stats" },
					"401": { "description": "Not authenticated" }
				}
			}
		},
		"/api/me/progress": {
			"get": {
				"tags": ["user"],
				"summary": "Get user progress",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"200": { "description": "Progress data" },
					"401": { "description": "Not authenticated" }
				}
			}
		},
		"/api/me/history": {
			"get": {
				"tags": ["user"],
				"summary": "Get paginated practice history",
				"security": [{ "sessionCookie": [] }],
				"parameters": [
					{
						"name": "page",
						"in": "query",
						"schema": { "type": "integer", "minimum": 1, "default": 1 }
					},
					{
						"name": "limit",
						"in": "query",
						"schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
					},
					{ "name": "course", "in": "query", "schema": { "type": "string" } },
					{ "name": "unit", "in": "query", "schema": { "type": "string" } },
					{ "name": "search", "in": "query", "schema": { "type": "string" } },
					{ "name": "kind", "in": "query", "schema": { "type": "string" } },
					{ "name": "result", "in": "query", "schema": { "type": "string" } },
					{ "name": "from", "in": "query", "schema": { "type": "string" } },
					{ "name": "to", "in": "query", "schema": { "type": "string" } },
					{ "name": "sortBy", "in": "query", "schema": { "type": "string" } },
					{ "name": "sortDir", "in": "query", "schema": { "type": "string" } }
				],
				"responses": {
					"200": { "description": "History page" },
					"401": { "description": "Not authenticated" }
				}
			}
		},
		"/api/me/bookmarks": {
			"get": {
				"tags": ["user"],
				"summary": "List bookmarked questions",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"200": { "description": "Bookmarked questions" },
					"401": { "description": "Not authenticated" }
				}
			},
			"post": {
				"tags": ["user"],
				"summary": "Toggle a question bookmark",
				"security": [{ "sessionCookie": [] }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["questionId"],
								"properties": {
									"questionId": { "type": "string" }
								}
							}
						}
					}
				},
				"responses": {
					"200": { "description": "Bookmark toggled" },
					"400": { "description": "questionId is required" },
					"401": { "description": "Not authenticated" }
				}
			}
		},
		"/api/me/record-attempt": {
			"post": {
				"tags": ["user"],
				"summary": "Record an MCQ attempt",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"200": { "description": "Attempt recorded" },
					"400": { "description": "Invalid attempt payload" },
					"401": { "description": "Not authenticated" }
				}
			}
		},
		"/api/me/quiz-attempts": {
			"post": {
				"tags": ["user"],
				"summary": "Save a completed quiz attempt",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"200": { "description": "Quiz history saved" },
					"400": { "description": "Invalid quiz payload" },
					"401": { "description": "Not authenticated" }
				}
			}
		},
		"/api/me/courses": {
			"post": {
				"tags": ["user"],
				"summary": "Save selected AP courses",
				"security": [{ "sessionCookie": [] }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["courses"],
								"properties": {
									"courses": {
										"type": "array",
										"items": { "type": "string" },
										"minItems": 1
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": { "description": "Saved course list" },
					"400": { "description": "Choose at least one valid AP course" },
					"401": { "description": "Not authenticated" },
					"413": { "description": "Request body too large" }
				}
			}
		},
		"/api/me/practice-data": {
			"delete": {
				"tags": ["user"],
				"summary": "Clear the signed-in user's practice data",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"200": { "description": "Practice data cleared" },
					"401": { "description": "Not authenticated" }
				}
			}
		},
		"/api/me/frq-attempt/{id}": {
			"get": {
				"tags": ["frq"],
				"summary": "Get a written-response attempt",
				"security": [{ "sessionCookie": [] }],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": { "description": "Attempt payload" },
					"401": { "description": "Not authenticated" },
					"403": { "description": "FRQ practice is disabled" },
					"404": { "description": "Attempt not found" }
				}
			}
		},
		"/api/me/tutor-profile": {
			"get": {
				"tags": ["super"],
				"summary": "Get Super tutor profile",
				"description": "Alias of GET /api/super/profile.",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"200": { "description": "Tutor profile and memory flags" },
					"401": { "description": "Not authenticated" }
				}
			},
			"patch": {
				"tags": ["super"],
				"summary": "Update Super tutor profile",
				"description": "Alias of PATCH /api/super/profile.",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"200": { "description": "Updated profile" },
					"400": { "description": "Invalid profile update" },
					"401": { "description": "Not authenticated" }
				}
			}
		},
		"/api/me/tutor-memories": {
			"get": {
				"tags": ["super"],
				"summary": "List Super tutor memories",
				"description": "Alias of GET /api/super/memory.",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"200": { "description": "Memory list" },
					"401": { "description": "Not authenticated" },
					"403": { "description": "Age not confirmed or feature unavailable" },
					"503": { "description": "Memory temporarily unavailable" }
				}
			},
			"post": {
				"tags": ["super"],
				"summary": "Acknowledge Super tutor memory disclosure",
				"description": "Alias of POST /api/super/memory.",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"200": { "description": "Disclosure acknowledged" },
					"401": { "description": "Not authenticated" },
					"403": { "description": "Age not confirmed" }
				}
			},
			"delete": {
				"tags": ["super"],
				"summary": "Delete all Super tutor memories",
				"description": "Alias of DELETE /api/super/memory.",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"200": { "description": "Memories deleted" },
					"401": { "description": "Not authenticated" },
					"503": { "description": "Memory not configured" }
				}
			}
		},
		"/api/me/tutor-memories/{memoryId}": {
			"delete": {
				"tags": ["super"],
				"summary": "Delete one Super tutor memory",
				"description": "Alias of DELETE /api/super/memory/{memoryId}.",
				"security": [{ "sessionCookie": [] }],
				"parameters": [{ "$ref": "#/components/parameters/memoryId" }],
				"responses": {
					"200": { "description": "Memory deleted" },
					"401": { "description": "Not authenticated" },
					"404": { "description": "Memory not found" }
				}
			}
		},
		"/api/tutor/chat": {
			"post": {
				"tags": ["tutor"],
				"summary": "Chat with the AI tutor about an MCQ",
				"description": "Public endpoint. Authentication is optional. Returns a streamed response.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["questionId", "message"],
								"properties": {
									"questionId": { "type": "string", "format": "uuid" },
									"message": { "type": "string", "maxLength": 2000 },
									"conversationHistory": {
										"type": "array",
										"maxItems": 12,
										"items": {
											"type": "object",
											"required": ["role", "content"],
											"properties": {
												"role": { "type": "string", "enum": ["user", "assistant"] },
												"content": { "type": "string" }
											}
										}
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": { "description": "Tutor response stream" },
					"400": { "description": "Invalid request" },
					"403": { "description": "Assistant features disabled for this account" },
					"404": { "description": "Question not found" },
					"413": { "description": "Request body too large" },
					"429": { "description": "Rate limited" },
					"500": { "description": "Tutor chat failed" }
				}
			}
		},
		"/api/tutor/greeting": {
			"post": {
				"tags": ["tutor"],
				"summary": "Get an AI tutor greeting for a question",
				"description": "Public endpoint. Authentication is optional.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["questionId"],
								"properties": {
									"questionId": { "type": "string", "format": "uuid" }
								}
							}
						}
					}
				},
				"responses": {
					"200": { "description": "Greeting message" },
					"400": { "description": "Invalid request" },
					"403": { "description": "Assistant features disabled for this account" },
					"404": { "description": "Question not found" },
					"429": { "description": "Rate limited" },
					"500": { "description": "Greeting failed (may include fallback message)" }
				}
			}
		},
		"/api/tutor/frq": {
			"post": {
				"tags": ["tutor"],
				"summary": "Chat with the AI tutor about an FRQ attempt",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"200": { "description": "Tutor response stream" },
					"400": { "description": "Invalid request" },
					"401": { "description": "Not authenticated" },
					"403": { "description": "FRQ practice or assistant features unavailable" },
					"413": { "description": "Request body too large" },
					"429": { "description": "Rate limited" }
				}
			}
		},
		"/api/super/agent": {
			"post": {
				"tags": ["coach"],
				"summary": "Start or continue a Super Coach conversation",
				"description": "Authenticated streaming endpoint. /api/coach is an alias.",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"200": { "description": "Coach response stream" },
					"401": { "description": "Not authenticated" },
					"403": { "description": "Coach is not available for this account" }
				}
			}
		},
		"/api/coach": {
			"post": {
				"tags": ["coach"],
				"summary": "Start or continue a Super Coach conversation",
				"description": "Alias of POST /api/super/agent.",
				"security": [{ "sessionCookie": [] }],
				"responses": {
					"200": { "description": "Coach response stream" },
					"401": { "description": "Not authenticated" },
					"403": { "description": "Coach is not available for this account" }
				}
			}
		},
		"/api/coach/practice-question": {
			"post": {
				"tags": ["coach"],
				"summary": "Have Coach serve a practice question",
				"security": [{ "sessionCookie": [] }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["course"],
								"properties": {
									"course": { "type": "string" },
									"unit": { "type": "string" },
									"mode": { "type": "string", "enum": ["mcq", "frq"], "default": "mcq" }
								}
							}
						}
					}
				},
				"responses": {
					"200": { "description": "Practice question" },
					"400": { "description": "Invalid request" },
					"401": { "description": "Not authenticated" },
					"403": { "description": "Coach is not available for this account" },
					"503": { "description": "Question pool warming" }
				}
			}
		},
		"/api/coach/undo": {
			"post": {
				"tags": ["coach"],
				"summary": "Undo a Coach action",
				"security": [{ "sessionCookie": [] }],
				"parameters": [
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": true,
						"schema": { "type": "string", "maxLength": 200 }
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["auditId"],
								"properties": {
									"auditId": { "type": "string" }
								}
							}
						}
					}
				},
				"responses": {
					"200": { "description": "Change undone" },
					"400": { "description": "Invalid undo request or missing idempotency key" },
					"401": { "description": "Not authenticated" },
					"403": { "description": "Coach is not available for this account" },
					"404": { "description": "Coach change was not found" },
					"409": { "description": "Undo already requested" },
					"503": { "description": "Undo temporarily unavailable" }
				}
			}
		},
		"/api/coach/actions/{id}/undo": {
			"post": {
				"tags": ["coach"],
				"summary": "Undo a Coach action by id",
				"description": "Alias of POST /api/coach/undo with auditId taken from the path.",
				"security": [{ "sessionCookie": [] }],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					},
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": true,
						"schema": { "type": "string", "maxLength": 200 }
					}
				],
				"responses": {
					"200": { "description": "Change undone" },
					"400": { "description": "Invalid undo request or missing idempotency key" },
					"401": { "description": "Not authenticated" },
					"404": { "description": "Coach change was not found" }
				}
			}
		},
		"/api/super/profile": {
			"get": {
				"tags": ["super"],
