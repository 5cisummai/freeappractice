{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true
	},
	"include": [
		"vite.config.js",
		"vite.config.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"tests/**/*.js",
		"tests/**/*.ts",
		"tests/**/*.svelte",
		"scripts/**/*.js",
		"scripts/**/*.ts",
		"scripts/**/*.svelte"
	],
	"exclude": ["node_modules", ".svelte-kit", "dist", "build"]
}
