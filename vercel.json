{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"crons": [
		{
			"path": "/api/cron/question-pool",
			"schedule": "0 * * * *"
		},
		{
			"path": "/api/cron/super-maintenance",
			"schedule": "30 3 * * *"
		}
	],
	"redirects": [
		{
			"source": "/practice",
			"destination": "/practice-tests",
			"statusCode": 301
		}
	]
}
